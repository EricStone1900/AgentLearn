# 浏览器请求使用相对路径，由开发服务器代理到后端。
VITE_API_BASE_URL=/api

# 仅供 vite.config.ts 使用，不会注入浏览器业务代码。
DEV_API_TARGET=http://127.0.0.1:3000

# 可以安全暴露给浏览器的页面标题。
VITE_APP_TITLE=智能文档问答助手

# 应与后端 MAX_UPLOAD_BYTES 保持一致。该值不是安全边界，后端仍会重新校验。
VITE_MAX_UPLOAD_BYTES=26214400

# 普通问答需要覆盖后端的 LLM_TIMEOUT_MS（当前 60000ms）。
VITE_API_TIMEOUT_MS=75000

# PDF 上传还包含解析、切分和向量化，使用独立的较长超时。
VITE_UPLOAD_TIMEOUT_MS=180000
