{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,

    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "node_modules",
    "dist"
  ]
}