# ============================================================
# 1. HTTP 服务
# ============================================================

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info


# ============================================================
# 2. 用户和命名空间
# ============================================================

# 第一版单用户模式使用的默认用户 ID。
# 后续增加登录系统后，应使用认证系统中的稳定用户 ID。
APP_DEFAULT_USER_ID=local-user

# 最终 RAG namespace 可以构造成：
# document-qa:local-user
RAG_NAMESPACE_PREFIX=document-qa


# ============================================================
# 3. 文件和上传
# ============================================================

# 用户上传文件的临时目录
UPLOAD_ROOT=./uploads

# 生成学习报告的目录
REPORT_ROOT=./reports

# 最大上传文件大小，单位为字节。
# 26214400 = 25 MB
MAX_UPLOAD_BYTES=26214400

# RAG 允许读取的知识库根目录
RAG_KNOWLEDGE_ROOT=./knowledge

# 单个 PDF 最大页数
MAX_PDF_PAGES=300

# PDF 至少需要提取出的有效字符数量。
# 小于此值时认为它可能是扫描件或空文档。
MIN_PDF_TEXT_CHARACTERS=20


# ============================================================
# 4. LLM
# ============================================================

# 使用 OpenAI-compatible 接口时建议使用 custom。
LLM_PROVIDER=custom

# 必须填写真实值，不能提交到 Git。
LLM_API_KEY=

# 示例：
# https://api.siliconflow.com/v1
# https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# 必须选择支持 Chat Completions 的模型。
# FunctionCallAgent 还要求模型支持原生工具调用。
LLM_MODEL_ID=

LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048


# ============================================================
# 5. Embedding
# ============================================================

# Embedding 可以与 LLM 使用同一个厂商，也可以使用不同厂商。
EMBEDDING_API_KEY=

# 当前示例使用 SiliconFlow
EMBEDDING_BASE_URL=https://api.siliconflow.com/v1

# 当前示例模型
EMBEDDING_MODEL=

# Qwen/Qwen3-Embedding-0.6B 使用 1024 维
EMBEDDING_DIMENSION=1024

# 如果服务端不接受 dimensions 参数，将它改成 false
EMBEDDING_SEND_DIMENSIONS=true


# ============================================================
# 6. SQLite
# ============================================================

# Memory 和 RAG 使用独立 SQLite 文件，便于备份和故障定位。
MEMORY_SQLITE_PATH=./data/memory.sqlite
RAG_SQLITE_PATH=./data/rag.sqlite

# Memory outbox 最大重试次数
MEMORY_OUTBOX_MAX_ATTEMPTS=5


# ============================================================
# 7. Qdrant
# ============================================================

# Memory 和 RAG 可以共用同一个 Qdrant 服务，
# 但必须使用不同的 collection。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Memory collection
QDRANT_COLLECTION=document_qa_memories_v1

# RAG collection
RAG_QDRANT_COLLECTION=document_qa_rag_v1


# ============================================================
# 8. RAG 切分
# ============================================================

RAG_CHUNK_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100


# ============================================================
# 9. Neo4j
# ============================================================

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j