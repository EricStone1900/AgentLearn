# 可选：不填写时自动检测 //modelscope
LLM_PROVIDER=custom

# 通用配置
LLM_API_KEY=your-api-key
LLM_MODEL_ID=your-model-id
LLM_BASE_URL=https://your-openai-compatible-service/v1

# 调用配置
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 搜索工具
TAVILY_API_KEY=
SERPAPI_API_KEY=

# 第二阶段记忆系统
MEMORY_SQLITE_PATH=.data/memory.sqlite
MEMORY_OUTBOX_MAX_ATTEMPTS=5

# 一致性维护命令可选：留空表示扫描全部用户
MEMORY_SCAN_USER_ID=

# 通用 Embedding 配置
# 当前示例使用 SiliconFlow；以后可替换为其他兼容厂商。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.com/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
# 模型支持 dimensions 请求参数时为 true；固定维度模型可设为 false
EMBEDDING_SEND_DIMENSIONS=true

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_memories_v1

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-in-local-env
NEO4J_DATABASE=neo4j

# Provider 专属密钥，按需配置一个
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MODELSCOPE_API_KEY=
# KIMI_API_KEY=
# ZHIPU_API_KEY=

# 本地服务
# OLLAMA_HOST=http://localhost:11434/v1
# VLLM_HOST=http://localhost:8000/v1
